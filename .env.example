# Modele de configuration : copier en .env puis renseigner les valeurs
# reelles. Le fichier .env n'est jamais versionne (.gitignore).
# Aucune valeur par defaut dans le code : une variable absente arrete le
# demarrage (app/config.py).

DATABASE_URL=sqlite:///dark_web_monitoring.db
FLASK_SECRET_KEY=a-remplacer-par-une-longue-valeur-aleatoire

TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=a-remplacer

# Optionnel (defaut : false). Marque le cookie de session "Secure", donc
# jamais transmis en clair. A passer a true des qu'un reverse proxy HTTPS est
# place devant Flask ; en HTTP direct, l'activer empeche toute connexion.
SESSION_COOKIE_SECURE=false
