@startuml Components_DarkWebMonitoring

' Architecture de Sentinel : deux processus Python sur la VM de collecte,
' qui ne communiquent que par la base de donnees.

package "VM isolee (Kali)" {

  package "Processus scheduler (app/scheduler.py)" {
    component "APScheduler\n(1 cycle / jour, heure aleatoire)" as Scheduler
    component "Supervision\n(verrou d'instance unique,\nevenements)" as Supervision

    package "Collecte (app/connectors)" {
      component "BaseConnector\n(FR-02 : listing, pagination,\npages de detail par priorite,\ndelai 30-45 s par source)" as BaseConnector
      component "Connecteurs\n(payload, orion_leaks, blackwater,\ndata_exposure_logs, safepay,\ncmd_organization, everest)" as Connecteurs
      component "Registre du crawl\n(app/crawl : entrees traitees,\nsignature de listing)" as Registre
    }

    component "Module Tor\n(FR-01 : proxy SOCKS, stem,\nrenouvellement de circuit)" as Tor

    package "Analyse (app/matching)" {
      component "Pipeline\n(app/pipeline.py)" as Pipeline
      component "Moteur de correspondance\n(exact, casse, RapidFuzz)" as Engine
      component "Faux positifs\n(FR-11)" as Exclusion
      component "Criticite + categories\n(FR-10, FR-13)" as Criticite
      component "Deduplication\n(FR-12)" as Dedup
    }

    component "Alertes\n(FR-25/26 : interface, email,\nSMS, WhatsApp)" as Alertes
    component "Conservation\n(derogation CN-04/CN-05 :\nmasquage du texte conserve)" as Conservation
  }

  package "Processus web (run.py)" {
    component "API JSON Flask\n(/api, 4 roles, en-tete XHR)" as API
    component "Telechargements\n(/reports, /compliance)" as Downloads
    component "Rapport mensuel\n(Jinja2 + WeasyPrint)" as PDF
    component "Interface React\n(frontend/dist, servie par Flask)" as SPA
  }

  database "SQLite\n(schema gere par Alembic)" as DB
  folder "logs/*.log\n(journaux tournants,\napp/journalisation.py)" as Logs
}

actor "Analyste CIRT\n(navigateur)" as Analyste
cloud "Sources .onion" as Onion

Scheduler --> Pipeline : cycle\n(N sources en parallele, analyse et\necritures sous verrou unique)
Scheduler --> Supervision
Connecteurs ..|> BaseConnector
Pipeline --> Connecteurs : collect()
Connecteurs --> Tor : get_via_tor()
Tor --> Onion : requetes passives
BaseConnector ..> Registre : entrees deja traitees\n(fournies par le pipeline)

Pipeline --> Engine : texte en memoire\n(CN-05)
Engine --> Exclusion
Exclusion --> Criticite
Criticite --> Dedup
Dedup --> DB : Exposition,\nSourceReference
Dedup --> Conservation : texte de l'annonce\net selecteurs trouves
Conservation --> DB : SourceReference.texte_brut\n(superviseur+ uniquement)
Pipeline --> Alertes
Pipeline --> Supervision : evenements
Registre --> DB
Supervision --> DB : EtatScheduler,\nEvenementCollecte
BaseConnector --> DB : JournalAudit

Analyste --> SPA : HTTP local (session ;\nHTTPS derriere un reverse proxy)
SPA --> API : fetch JSON
SPA --> Downloads : liens natifs
Downloads --> PDF
API --> DB
Downloads --> DB
API ..> Supervision : demandes (collecte immediate,\nverification IP) via la base
Scheduler ..> Logs : scheduler.log\n(pipeline.log : collecte manuelle)
API ..> Logs : web.log

@enduml
